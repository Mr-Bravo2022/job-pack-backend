{
  "name": "job-pack-backend",
  "version": "1.0.0",
  "description": "Job Pack backend — Koa + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "build:full": "cd ../frontend && npm install && npm run build && mkdir -p ../backend/public && cp -r dist/* ../backend/public/ && cd ../backend && npm install && npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@koa/bodyparser": "^5.1.1",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^13.1.0",
    "dotenv": "^16.4.5",
    "koa": "^2.15.3",
    "koa-cors": "^0.0.16",
    "koa-static": "^5.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.43.1",
    "sql.js": "^1.14.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__multer": "^2.0.8",
    "@types/koa__router": "^12.0.4",
    "@types/koa-cors": "^0.0.6",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^20.14.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
